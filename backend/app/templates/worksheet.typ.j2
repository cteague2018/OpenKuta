#set page(
  paper: "us-letter",
  margin: (top: 0.5in, bottom: 0.5in, left: 0.5in, right: 0.5in),
  header: none,
  footer: none,
)

#set text(font: "Liberation Sans", size: 10pt)

// ArUco Corner Fiducials for Perspective Correction (4x4 Markers 0, 1, 2, 3)
#place(top + left, dx: -0.15in, dy: -0.15in, image("{{ marker_top_left }}", width: 0.45in, height: 0.45in))
#place(top + right, dx: 0.15in, dy: -0.15in, image("{{ marker_top_right }}", width: 0.45in, height: 0.45in))
#place(bottom + left, dx: -0.15in, dy: 0.15in, image("{{ marker_bottom_left }}", width: 0.45in, height: 0.45in))
#place(bottom + right, dx: 0.15in, dy: 0.15in, image("{{ marker_bottom_right }}", width: 0.45in, height: 0.45in))

// Header Layout
#v(0.1in)
#grid(
  columns: (1fr, auto),
  align: (left + horizon, right + horizon),
  [
    #text(size: 14pt, weight: "bold")[{{ title }}] \
    #v(2pt)
    #text(size: 9pt, fill: luma(80))[
      {% if student_name %}
      Name: #text(weight: "bold", fill: black)[{{ student_name }}] #h(0.2in)
      Date: #underline[#h(0.8in)] #h(0.2in)
      Period: #text(weight: "bold", fill: black)[{{ student_period or "___" }}]
      {% if student_id %}
      #h(0.2in) Student ID: #text(weight: "bold", font: "Liberation Sans", fill: black)[{{ student_id }}]
      {% endif %}
      {% else %}
      Name: #underline[#h(1.8in)] #h(0.2in)
      Date: #underline[#h(0.9in)] #h(0.2in)
      Period: #underline[#h(0.6in)]
      {% endif %}
    ]
  ],
  [
    #grid(
      columns: (auto, auto),
      gutter: 8pt,
      align: horizon,
      [
        #align(center)[
          #rect(fill: rgb(238, 242, 255), stroke: 1pt + rgb(99, 102, 241), radius: 3pt, inset: (x: 8pt, y: 4pt))[
            #text(size: 11pt, weight: "bold", fill: rgb(67, 56, 202))[Form {{ form_id }}]
          ] \
          #v(1pt)
          #text(size: 6.5pt, fill: luma(100))[ID: {{ worksheet_id }}]
          {% if student_id %}
          \ #text(size: 6pt, fill: rgb(99, 102, 241), weight: "bold")[SID: {{ student_id }}]
          {% endif %}
        ]
      ],
      [
        #image("{{ qr_path }}", width: 0.65in, height: 0.65in)
      ]
    )
  ]
)

#v(4pt)
#line(length: 100%, stroke: 0.75pt + luma(180))
#v(6pt)

// Problem Grid with Pre-computed Bounded Workspace Clearance
#grid(
  {% if columns == 1 %}
  columns: (1fr,),
  {% elif columns == 3 %}
  columns: (1fr, 1fr, 1fr),
  {% else %}
  columns: (1fr, 1fr),
  {% endif %}
  column-gutter: 14pt,
  row-gutter: 10pt,
  {% for prob in problems %}
  [
    #rect(
      width: {{ "3in" if prob.graphing else "100%" }},
      height: {{ graphing_box_height_pt if prob.graphing else box_height_pt }}pt,
      stroke: 0.6pt + luma(190),
      radius: 4pt,
      inset: (x: 6pt, y: 4pt)
    )[
      #grid(
        columns: (1fr, auto),
        align: (left, right),
        [
          #text(weight: "bold", size: 10pt)[{{ loop.index }}.]
          #h(4pt)
          #text(size: 7.5pt, fill: luma(90))[{{ prob.prompt_text }}]
        ],
        [
          {% if prob.difficulty == 'mild' %}
          #text(size: 7.5pt, weight: "bold", fill: rgb(16, 149, 193))[MILD]
          {% elif prob.difficulty == 'medium' %}
          #text(size: 7.5pt, weight: "bold", fill: rgb(217, 119, 6))[MEDIUM]
          {% else %}
          #text(size: 7.5pt, weight: "bold", fill: rgb(220, 38, 38))[SPICY]
          {% endif %}
        ]
      )

      {% if columns == 1 and ((show_answers and answer_svg_files and loop.index in answer_svg_files) or (diagram_files and loop.index in diagram_files)) %}
      #v(2pt)
      #grid(
        columns: (1fr, auto),
        align: (horizon, horizon),
        gutter: 14pt,
        [
          #align(center)[
            #text(size: 11pt)[{{ prob.equation_typst }}]
          ]
          {% if prob.choices and prob.choices|length >= 4 %}
          #v(6pt)
          #grid(
            columns: (1fr, 1fr),
            row-gutter: 4pt,
            column-gutter: 8pt,
            {% for ch in prob.choices %}
            [ #text(size: 8.5pt, weight: "bold")[{{ ch.letter }})] #text(size: 8.5pt)[{{ ch.text }}] ],
            {% endfor %}
          )
          {% endif %}
        ],
        [
          {% if show_answers and answer_svg_files and loop.index in answer_svg_files %}
          #image("{{ answer_svg_files[loop.index] }}", height: {{ ((box_height_pt * 0.75) | int) if (box_height_pt * 0.75) < 135 else 135 }}pt, fit: "contain")
          {% elif diagram_files and loop.index in diagram_files %}
          #image(
            "{{ diagram_files[loop.index] }}",
            {% if prob.graphing %}width: 3in, height: 3in{% else %}height: {{ ((box_height_pt * 0.75) | int) if (box_height_pt * 0.75) < 135 else 135 }}pt{% endif %},
            fit: "contain"
          )
          {% if prob.graphing %}
          #v(4pt)
          #text(size: 8pt, fill: blue.darken(20%))[Grid Scale: 1 square = #underline[#h(0.6in)] units]
          {% endif %}
          {% endif %}
        ]
      )
      {% else %}
      #v(4pt)
      #align(center)[
        #text(size: 10.5pt)[{{ prob.equation_typst }}]
      ]

      {% if show_answers and answer_svg_files and loop.index in answer_svg_files %}
      #v(1pt)
      #align(center)[
        #image("{{ answer_svg_files[loop.index] }}", height: {{ ((box_height_pt * 0.58) | int) if (box_height_pt * 0.58) < 170 else 170 }}pt, width: 100%, fit: "contain")
      ]
      {% elif diagram_files and loop.index in diagram_files %}
      #v(1pt)
      #align(center)[
        #image(
          "{{ diagram_files[loop.index] }}",
          {% if prob.graphing %}width: 3in, height: 3in{% else %}height: {{ ((box_height_pt * 0.58) | int) if (box_height_pt * 0.58) < 170 else 170 }}pt, width: 100%{% endif %},
          fit: "contain"
        )
      ]
      {% if prob.graphing %}
      #v(4pt)
      #text(size: 8pt, fill: blue.darken(20%))[Grid Scale: 1 square = #underline[#h(0.6in)] units]
      {% endif %}
      {% endif %}

      {% if prob.choices and prob.choices|length >= 4 %}
      #v(6pt)
      #grid(
        columns: (1fr, 1fr),
        row-gutter: 6pt,
        column-gutter: 10pt,
        {% for ch in prob.choices %}
        [ #text(size: 8.5pt, weight: "bold")[{{ ch.letter }})] #text(size: 8.5pt)[{{ ch.text }}] ],
        {% endfor %}
      )
      {% endif %}
      {% endif %}

      #align(bottom + right)[
        #rect(stroke: 0.5pt + luma(200), radius: 2pt, inset: (x: 10pt, y: 4pt))[
          #text(size: 7.5pt, fill: luma(140))[Ans: {% if show_answers %}{{ prob.correct_choice + ") " if prob.correct_choice else "" }}{{ prob.answer_typst }}{% endif %}]
        ]
      ]
    ]
  ],
  {% endfor %}
)

